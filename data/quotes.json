[
  {
    "id": "q01",
    "topic": "股权设计",
    "text": "股权分配解决的是今天的贡献，股权机制还要面对明天的变化。",
    "source": "编辑观点",
    "isEditorial": true
  },
  {
    "id": "q02",
    "topic": "股权设计",
    "text": "比例写在纸上，治理运行在日常决策里。",
    "source": "编辑观点",
    "isEditorial": true
  },
  {
    "id": "q03",
    "topic": "公司架构",
    "text": "好的架构不是层级越多越专业，而是权责越清楚越有效。",
    "source": "编辑观点",
    "isEditorial": true
  },
  {
    "id": "q04",
    "topic": "控制权",
    "text": "控制权不是一句口号，而是一组能够合法、稳定运行的权利安排。",
    "source": "编辑观点",
    "isEditorial": true
  },
  {
    "id": "q05",
    "topic": "激励机制",
    "text": "激励的价值不只在于给出权益，更在于让贡献、责任与长期价值相匹配。",
    "source": "编辑观点",
    "isEditorial": true
  },
  {
    "id": "q06",
    "topic": "创始人关系",
    "text": "分股的公平感来自过程透明，而不是来自某个具体的比例数字。",
    "source": "编辑观点",
    "isEditorial": true
  },
  {
    "id": "q07",
    "topic": "融资与稀释",
    "text": "每一轮融资都是在未来的控制版图上画线。重要的不是画了多少条，而是线画在哪。",
    "source": "编辑观点",
    "isEditorial": true
  },
  {
    "id": "q08",
    "topic": "股东退出",
    "text": "退出条款的价值，只在关系破裂时才被检验。写的时候越冷静，执行时越体面。",
    "source": "编辑观点",
    "isEditorial": true
  },
  {
    "id": "q09",
    "topic": "治理",
    "text": "公司治理不是合规审查，而是决策权、信息权与责任在平时如何运转。",
    "source": "编辑观点",
    "isEditorial": true
  },
  {
    "id": "q10",
    "topic": "长期主义",
    "text": "把股权看作一种跨越时间的承诺机制，而不是一次性的所有权分割。",
    "source": "编辑观点",
    "isEditorial": true
  },
  {
    "id": "q11",
    "topic": "治理",
    "text": "治理结构不能替代商业质量；再漂亮的董事会，也救不了持续恶化的业务。",
    "source": "编辑观点（对商业常识的原创总结）",
    "isEditorial": true
  },
  {
    "id": "q12",
    "topic": "创始人关系",
    "text": "好的交易不是把每一步都谈到对方让步，而是让共同创造的价值足够大。",
    "source": "编辑观点（原创总结）",
    "isEditorial": true
  },
  {
    "id": "q13",
    "topic": "创始人关系",
    "text": "创业路上更常见的遗憾，不是选错了方向，而是长期和错的人一起走。",
    "source": "编辑观点（原创总结）",
    "isEditorial": true
  },
  {
    "id": "q14",
    "topic": "公司架构",
    "text": "结构不能替代战略；结构只能让战略更容易被看清、被执行。",
    "source": "编辑观点（原创总结）",
    "isEditorial": true
  },
  {
    "id": "q15",
    "topic": "激励机制",
    "text": "不要把股权激励当成薪酬的替代品。它是一份关于长期承诺的协议，而不是一份延期支付的工资。",
    "source": "编辑观点",
    "isEditorial": true
  },
  {
    "id": "q16",
    "topic": "控制权",
    "text": "董事会的权力不在投票的那一刻，而在议程怎么定、信息怎么给。",
    "source": "编辑观点",
    "isEditorial": true
  },
  {
    "id": "q17",
    "topic": "股权设计",
    "text": "公司不是一个人的企业。股权安排就是在设计一种共同治理的语言。",
    "source": "编辑观点",
    "isEditorial": true
  }
]